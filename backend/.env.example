# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Public base URL of this API (used for signed local bill-image URLs)
SERVER_URL=http://localhost:3000
# Number of proxy hops in front of the app (production only; Vercel = 1)
TRUST_PROXY=1

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/billTracker

# Session (REQUIRED in production - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=
# Optional dedicated secrets (fall back to SESSION_SECRET if unset)
OTP_SECRET=
IMAGE_SIGNING_SECRET=
# Optional token required to scrape /metrics in production
METRICS_TOKEN=
# Optional Redis URL so rate-limit counters are shared across instances/replicas
# (falls back to an in-memory store when unset). Example with monitoring stack:
# REDIS_URL=redis://:your-redis-password@localhost:6379
REDIS_URL=

# AI extraction
GEMINI_API_KEY=
OLLAMA_MODEL=llama3.2-vision

# Uploads
# UPLOAD_DIR defaults to ./uploads locally and os.tmpdir() on Vercel (read-only FS)
UPLOAD_DIR=
# Max upload size in MB (defaults to 10 locally, 4 on Vercel)
MAX_UPLOAD_MB=

# Cloudinary (bill image storage - REQUIRED in production; no persistent local disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# OAuth - Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# OAuth - Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback

# OTP email (Gmail app password)
EMAIL_USER=
EMAIL_PASS=
