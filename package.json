{
  "name": "bill-scanning",
  "version": "1.0.0",
  "private": true,
  "description": "Bill tracker with AI-powered bill scanning",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:monitoring": "docker compose -f monitoring/docker-compose.yml up -d",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend run test:run",
    "test:frontend": "npm --prefix frontend run test:run",
    "lint": "npm --prefix frontend run lint",
    "build": "npm --prefix frontend run build"
  }
}
